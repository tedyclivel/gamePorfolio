{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameporfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "RECAPTCHA_MIN_SCORE": "0.5"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
